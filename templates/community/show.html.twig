{% extends 'layout.html.twig' %}

{% block title %}{{ post ? post.title : 'Discussion not available' }} — ForkLore Community{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/community.css') }}">
{% endblock %}

{% block content %}
    {% if post %}
    <main class="post-detail-page">
        <a href="{{ path('community_index') }}" class="back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back to Community
        </a>

        <div class="post-hero">
            <div class="post-hero-meta">
                {% set author = post.user ? post.user.username : 'Unknown' %}
                <div class="post-hero-avatar">{{ author|slice(0, 1)|upper }}</div>
                <div class="post-hero-byline">
                    {% if post.user %}<a href="{{ path('profile_show', { username: post.user.username }) }}"><strong>{{ author }}</strong></a>{% else %}<strong>{{ author }}</strong>{% endif %}
                    <span>{{ post.createdAt|date('F j, Y \\a\\t g:i A') }}</span>
                </div>
                <span class="cat-badge post-hero-category">{{ post.category }}</span>
            </div>

            <h1>{{ post.title }}</h1>

            <div class="post-hero-content">
                {{ post.content|nl2br }}
            </div>

            {% if canManagePost|default(false) %}
                <details style="margin-top:16px;">
                    <summary class="primary-btn" style="display:inline-block;cursor:pointer;">Edit / Delete Post</summary>
                    <form method="post" action="{{ path('community_show', { id: post.id }) }}" style="margin-top:12px;display:grid;gap:10px;">
                        <input type="hidden" name="action" value="edit_post">
                        <input type="hidden" name="_token" value="{{ csrf_token('community_edit_post_' ~ post.id) }}">
                        <label>Title<br><input type="text" name="title" value="{{ post.title }}" required style="width:100%;padding:8px;"></label>
                        <label>Category<br>
                            <select name="category" style="padding:8px;">
                                {% for c in categories|default(['General', 'Recipe Help', 'Tips & Tricks', 'Equipment']) %}
                                    <option value="{{ c }}" {{ post.category == c ? 'selected' : '' }}>{{ c }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label>Content<br><textarea name="content" rows="6" required style="width:100%;padding:8px;">{{ post.content }}</textarea></label>
                        <button type="submit" class="primary-btn">Save Changes</button>
                    </form>
                    <form method="post" action="{{ path('community_delete', { id: post.id }) }}" onsubmit="return confirm('Delete this post? This action cannot be undone.');" style="margin-top:10px;">
                        <input type="hidden" name="_token" value="{{ csrf_token('community_delete_post_' ~ post.id) }}">
                        <button type="submit" class="card-delete-btn">Delete Post</button>
                    </form>
                </details>
            {% endif %}
        </div>

        {% if error %}
            <div class="support-inline-alert support-inline-alert--error" role="alert">{{ error }}</div>
        {% endif %}

        <section class="replies-section" id="replies">
            <h2 class="replies-section-header">
                Replies
                <span class="reply-total">{{ replies|length }}</span>
            </h2>
            {% if replies is empty %}
                <div class="no-replies">
                    No replies yet &mdash; be the first to join the conversation!
                </div>
            {% else %}
                <div class="reply-list">
                    {% for reply in replies %}
                        {% set replyAuthor = reply.user ? reply.user.username : 'Unknown' %}
                        <article class="reply-card">
                            <div class="reply-card-top">
                                <div class="reply-avatar">{{ replyAuthor|slice(0, 1)|upper }}</div>
                                {% if reply.user %}
                                    <a href="{{ path('profile_show', { username: reply.user.username }) }}" class="reply-author">{{ replyAuthor }}</a>
                                {% else %}
                                    <span class="reply-author">{{ replyAuthor }}</span>
                                {% endif %}
                                <span class="reply-date">{{ reply.createdAt|date('M j, Y g:i A') }}</span>
                            </div>
                            <div class="reply-text">{{ reply.comment|nl2br }}</div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        <div class="reply-form-box">
            <h2>Leave a Reply</h2>
            {% if app.user %}
                <form method="post" action="{{ path('community_show', { id: post.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('community_reply_' ~ post.id) }}">
                    <div class="form-group">
                        <label for="comment">Your Reply</label>
                        <textarea
                            id="comment"
                            name="comment"
                            rows="5"
                            placeholder="Share your thoughts, answer the question, or add to the discussion…"
                            required
                        ></textarea>
                    </div>
                    <button type="submit" class="reply-submit-btn">Post Reply &rarr;</button>
                </form>
            {% else %}
                <p>Please <a href="{{ path('login') }}">log in</a> to reply to this thread.</p>
            {% endif %}
        </div>
    </main>
    {% else %}
    <main class="post-detail-page">
        <a href="{{ path('community_index') }}" class="back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back to Community
        </a>
        <div class="empty-feed">
            <h3>No discussion available yet.</h3>
            <p>Discussions will appear here once the database is connected.</p>
        </div>
    </main>
    {% endif %}
{% endblock %}
