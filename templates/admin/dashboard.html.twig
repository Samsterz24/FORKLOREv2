{% extends 'admin/base.html.twig' %}

{% block title %}Admin Dashboard &amp; Analytics | ForkLore{% endblock %}
{% block admin_heading %}Dashboard{% endblock %}
{% block admin_subheading %}A live-looking overview of users, recipes, support, and activity.{% endblock %}

{% block admin_content %}
    <section class="admin-stats-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon">👥</div>
            <div class="admin-stat-meta">
                <h3>{{ stats.users ?? '—' }}</h3>
                <p>Registered Users</p>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon">🛡️</div>
            <div class="admin-stat-meta">
                <h3>{{ stats.staff ?? '—' }}</h3>
                <p>Total Staff</p>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon">📚</div>
            <div class="admin-stat-meta">
                <h3>{{ stats.totalRecords ?? '—' }}</h3>
                <p>Total Records</p>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon">💬</div>
            <div class="admin-stat-meta">
                <h3>{{ stats.openTickets ?? '—' }}</h3>
                <p>Open Support Tickets</p>
            </div>
        </div>
    </section>

    <div class="admin-grid-2col">
        <section class="admin-section-card">
            <div class="admin-section-header">
                <h2>📈 User Interaction Trends</h2>
                <span class="admin-muted">Past 7 days</span>
            </div>
            <div class="admin-chart-box">
                {% if chart %}
                    <canvas id="interactionChart" aria-label="User interaction trends for the past seven days" role="img"></canvas>
                {% else %}
                    <p class="admin-chart-empty">Interaction data will appear here once the database is connected.</p>
                {% endif %}
            </div>
        </section>

        <section class="admin-section-card">
            <div class="admin-section-header">
                <h2>💬 Support Tickets</h2>
                <a href="{{ path('admin_support') }}" class="admin-inline-link">View All &rarr;</a>
            </div>

            <div class="admin-ticket-list-mini">
                {% for ticket in recentTickets %}
                    <a href="{{ path('admin_support', { ticket_id: ticket.id }) }}" class="admin-ticket-mini-item">
                        <div class="admin-ticket-mini-info">
                            <h4>{{ ticket.subject|length > 26 ? ticket.subject|slice(0, 26) ~ '...' : ticket.subject }}</h4>
                            <p>{{ ticket.user }} &bull; {{ ticket.createdAt|date('M d') }}</p>
                        </div>
                        <span class="admin-badge admin-badge-{{ ticket.status }}">{{ ticket.status|replace({ '_': ' ' }) }}</span>
                    </a>
                {% else %}
                    <p class="admin-empty-inline">No support tickets yet.</p>
                {% endfor %}
            </div>
        </section>
    </div>

    <section class="admin-section-card admin-section-card--spaced">
        <div class="admin-section-header">
            <h2>🏆 Recipe Leaderboard</h2>
            <div class="admin-leaderboard-tabs">
                <a href="{{ path('admin_dashboard', { leaderboard: 'daily' }) }}" class="admin-lead-tab {{ timeframe == 'daily' ? 'active' : '' }}">Daily</a>
                <a href="{{ path('admin_dashboard', { leaderboard: 'weekly' }) }}" class="admin-lead-tab {{ timeframe == 'weekly' ? 'active' : '' }}">Weekly</a>
                <a href="{{ path('admin_dashboard', { leaderboard: 'all_time' }) }}" class="admin-lead-tab {{ timeframe == 'all_time' ? 'active' : '' }}">All-Time</a>
            </div>
        </div>

        <div class="admin-table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="admin-col-rank">Rank</th>
                        <th>Recipe Title</th>
                        <th>Category</th>
                        <th>Author</th>
                        <th class="admin-text-right">Total Favorites</th>
                    </tr>
                </thead>
                <tbody>
                    {% for recipe in leaderboard %}
                        <tr>
                            <td>
                                {% if loop.index == 1 %}
                                    <span class="admin-rank-medal admin-rank-1">1</span>
                                {% elseif loop.index == 2 %}
                                    <span class="admin-rank-medal admin-rank-2">2</span>
                                {% elseif loop.index == 3 %}
                                    <span class="admin-rank-medal admin-rank-3">3</span>
                                {% else %}
                                    <span class="admin-rank-other">#{{ loop.index }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('recipes_show', { id: recipe.id }) }}" class="admin-recipe-link">{{ recipe.title }}</a>
                            </td>
                            <td><span class="admin-badge admin-badge-category">{{ recipe.category }}</span></td>
                            <td>{{ recipe.author }}</td>
                            <td class="admin-text-right admin-rank-likes">♥ {{ recipe.totalLikes }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="admin-empty-cell">No recipe interaction data available for this timeframe.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-section-card">
        <div class="admin-section-header">
            <h2>⚠️ Staff Warning Records</h2>
            <span class="admin-muted">Latest warnings issued by staff (visible to admins)</span>
        </div>

        <div class="admin-table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="admin-col-id">ID</th>
                        <th>Timestamp</th>
                        <th>Staff</th>
                        <th>Target User</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    {% for w in recentWarnings|default([]) %}
                        <tr>
                            <td><strong>#{{ w.id }}</strong></td>
                            <td class="admin-muted">{{ w.createdAt|date('M d, Y H:i') }}</td>
                            <td><strong>{{ w.staff }}</strong></td>
                            <td><a href="{{ path('profile_show', { username: w.targetUsername }) }}"><strong>{{ w.target }}</strong></a></td>
                            <td class="admin-log-details">{{ w.reason }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="admin-empty-cell">No staff warnings recorded yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {% if chart %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            var canvas = document.getElementById('interactionChart');
            if (!canvas || typeof Chart === 'undefined') {
                return;
            }

            new Chart(canvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels: {{ chart.labels|json_encode|raw }},
                    datasets: [{
                        label: 'User Interactions',
                        data: {{ chart.values|json_encode|raw }},
                        borderColor: '#d3541b',
                        backgroundColor: 'rgba(211, 84, 27, 0.1)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#d3541b',
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#17120d',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, color: '#8c7e73' },
                            grid: { color: '#faede2' }
                        },
                        x: {
                            ticks: { color: '#8c7e73' },
                            grid: { display: false }
                        }
                    }
                }
            });
        })();
    </script>
    {% endif %}
{% endblock %}
