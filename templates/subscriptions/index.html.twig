{% extends 'layout.html.twig' %}

{% block title %}Lore Foodie Stamp Subscription - ForkLore{% endblock %}

{% block content %}
    <main class="subscription-page" style="max-width:950px;margin:40px auto;padding:0 20px;">
        {% if success %}
            <div class="subscription-success" style="background:#e6fffa;border:2px solid #38b2ac;color:#234e52;padding:18px 24px;border-radius:14px;margin-bottom:30px;text-align:center;font-weight:700;">
                {{ success }}
                <div style="margin-top:10px;"><a href="{{ path('profile') }}" style="color:#2c7a7b;text-decoration:underline;font-size:14px;">Return to your profile &rarr;</a></div>
            </div>
        {% endif %}
        {% if errors is not empty %}
            <div class="subscription-errors" style="background:#fff5f5;border:2px solid #e53e3e;color:#742a2a;padding:18px 24px;border-radius:14px;margin-bottom:30px;">
                <strong>Please check the following details:</strong>
                <ul style="margin:0;padding-left:20px;font-size:14px;">
                    {% for e in errors %}<li>{{ e }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <div style="background:linear-gradient(135deg,#2b170c,#422210);color:#fff;border-radius:20px;padding:35px 30px;border:1px solid #e28743;margin-bottom:30px;position:relative;overflow:hidden;">
            <h1 style="font-size:32px;font-weight:800;margin:0 0 10px 0;">Join the Lore Foodie Stamp Club</h1>
            <p style="font-size:16px;color:#d6c6bb;margin:0;max-width:600px;line-height:1.5;">Support culinary creators and sport the golden 🏅 Lore Foodie badge.</p>
            <div style="margin-top:20px;">
                {% if user.hasFoodieStamp %}
                    <span style="background:rgba(16,185,129,0.2);border:1px solid #10b981;color:#34d399;font-size:13px;font-weight:700;padding:6px 16px;border-radius:20px;">✓ Active (until {{ user.stampExpiresAt|date('M d, Y') }})</span>
                {% else %}
                    <span style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#fde68a;font-size:13px;font-weight:600;padding:6px 16px;border-radius:20px;">Standard Account</span>
                {% endif %}
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1.3fr;gap:30px;align-items:start;">
            <div style="background:#fff;border:1px solid #fae8d7;border-radius:16px;padding:24px;box-shadow:0 4px 16px rgba(0,0,0,0.04);">
                <h3 style="font-size:18px;font-weight:800;color:#17120d;margin:0 0 16px 0;">Membership Privileges</h3>
                <div style="display:flex;flex-direction:column;gap:16px;">
                    <div style="display:flex;gap:14px;"><div style="font-size:22px;">👨‍🍳</div><div><strong style="color:#d3541b;font-size:14px;display:block;">Verified Chef Access</strong><span style="font-size:13px;color:#634f40;">Unlimited digital access to master culinary guides.</span></div></div>
                    <div style="display:flex;gap:14px;"><div style="font-size:22px;">💰</div><div><strong style="color:#d3541b;font-size:14px;display:block;">Recipe Monetization</strong><span style="font-size:13px;color:#634f40;">Earn revenue from your creations.</span></div></div>
                    <div style="display:flex;gap:14px;"><div style="font-size:22px;">🏅</div><div><strong style="color:#d3541b;font-size:14px;display:block;">Official Badge</strong><span style="font-size:13px;color:#634f40;">Stand out in comments and profiles.</span></div></div>
                </div>
            </div>

            <div style="background:#fff;border:1px solid #fae8d7;border-radius:16px;padding:30px;box-shadow:0 6px 24px rgba(211,84,27,0.08);">
                <h3 style="font-size:20px;font-weight:800;color:#17120d;margin:0 0 20px 0;">Payment Details</h3>
                <form method="POST" action="{{ path('subscriptions_index') }}" id="subscription-form">
                    <input type="hidden" name="submit_subscription" value="1">
                    <div style="margin-bottom:16px;">
                        <label style="display:block;font-size:13px;font-weight:700;color:#333;margin-bottom:6px;">Plan</label>
                        <select name="plan_type" style="width:100%;padding:10px 14px;border:1px solid #d8c7b8;border-radius:8px;font-size:14px;">
                            <option value="monthly" {{ planType == 'monthly' ? 'selected' : '' }}>Monthly $2.99</option>
                            <option value="annual" {{ planType == 'annual' ? 'selected' : '' }}>Annual $29.99</option>
                        </select>
                    </div>
                    <div style="margin-bottom:16px;">
                        <label style="display:block;font-size:13px;font-weight:700;color:#333;margin-bottom:6px;">Payment Method</label>
                        <select name="payment_method" style="width:100%;padding:10px 14px;border:1px solid #d8c7b8;border-radius:8px;font-size:14px;">
                            <option value="Mock Card">Mock Card</option>
                            <option value="Mock GCash">Mock GCash</option>
                        </select>
                    </div>
                    <div style="margin-bottom:16px;">
                        <label style="display:block;font-size:13px;font-weight:700;color:#333;margin-bottom:6px;">Cardholder Name</label>
                        <input type="text" name="card_name" value="{{ user.username }}" style="width:100%;box-sizing:border-box;padding:10px 14px;border:1px solid #d8c7b8;border-radius:8px;font-size:14px;">
                    </div>
                    <div style="margin-bottom:16px;">
                        <label style="display:block;font-size:13px;font-weight:700;color:#333;margin-bottom:6px;">Card Number</label>
                        <input type="text" name="card_number" value="4242 4242 4242 4242" style="width:100%;box-sizing:border-box;padding:10px 14px;border:1px solid #d8c7b8;border-radius:8px;font-size:14px;">
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
                        <div>
                            <label style="display:block;font-size:13px;font-weight:700;color:#333;margin-bottom:6px;">Expiry (MM/YY)</label>
                            <input type="text" name="card_expiry" value="12/28" style="width:100%;box-sizing:border-box;padding:10px 14px;border:1px solid #d8c7b8;border-radius:8px;font-size:14px;">
                        </div>
                        <div>
                            <label style="display:block;font-size:13px;font-weight:700;color:#333;margin-bottom:6px;">CVV</label>
                            <input type="password" name="card_cvv" value="789" style="width:100%;box-sizing:border-box;padding:10px 14px;border:1px solid #d8c7b8;border-radius:8px;font-size:14px;">
                        </div>
                    </div>
                    <div style="margin-bottom:22px;">
                        <label style="display:block;font-size:13px;font-weight:700;color:#333;margin-bottom:6px;">Billing Zip</label>
                        <input type="text" name="billing_zip" value="90210" style="width:100%;box-sizing:border-box;padding:10px 14px;border:1px solid #d8c7b8;border-radius:8px;font-size:14px;">
                    </div>
                    <button type="submit" class="primary-btn" style="width:100%;padding:15px;font-size:16px;font-weight:800;border-radius:30px;">Authorize & Subscribe</button>
                </form>
            </div>
        </div>
    </main>
{% endblock %}