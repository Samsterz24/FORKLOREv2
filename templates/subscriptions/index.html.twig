{% extends 'layout.html.twig' %}

{% block title %}Lore Foodie Stamp Subscription - ForkLore{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/subscriptions.css') }}">
{% endblock %}

{% block content %}
    <main class="subscription-page">
        {% if success %}
            <div class="subscription-success">
                {{ success }}
                <div style="margin-top:10px;"><a href="{{ path('profile') }}" style="color:#2c7a7b;text-decoration:underline;font-size:14px;">Return to your profile &rarr;</a></div>
            </div>
        {% endif %}
        {% if errors is not empty %}
            <div class="subscription-errors">
                <strong>Please check the following details:</strong>
                <ul style="margin:0;padding-left:20px;font-size:14px;">
                    {% for e in errors %}<li>{{ e }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="subscription-hero">
            <h1>Join the Lore Foodie Stamp Club</h1>
            <p>Support culinary creators and sport the golden 🏅 Lore Foodie badge. Choose the tier that fits you best.</p>
            <div style="margin-top:20px;">
                {% if user.hasFoodieStamp %}
                    <span class="stamp-active-badge">✓ Active{% if user.stampExpiresAt %} (until {{ user.stampExpiresAt|date('M d, Y') }}){% endif %}</span>
                {% else %}
                    <span class="stamp-standard-badge">Standard Account</span>
                {% endif %}
            </div>
        </div>

        {# Pricing tiers #}
        <div class="pricing-grid">
            <div class="pricing-card" data-tier="basic">
                <div class="pricing-card-header">
                    <h3>Basic</h3>
                    <div class="pricing-price"><span class="pricing-currency">$</span><span class="pricing-amount">2.99</span><span class="pricing-period">/mo</span></div>
                </div>
                <ul class="pricing-features">
                    <li>🏅 Official Foodie Badge</li>
                    <li>👨‍🍳 Verified Chef Access</li>
                    <li>📖 Unlimited recipe browsing</li>
                    <li>💬 Community posting</li>
                </ul>
                <button type="button" class="pricing-select-btn" data-tier="basic">Select Basic</button>
            </div>

            <div class="pricing-card pricing-card--featured" data-tier="plus">
                <div class="pricing-card-badge">Most Popular</div>
                <div class="pricing-card-header">
                    <h3>Plus</h3>
                    <div class="pricing-price"><span class="pricing-currency">$</span><span class="pricing-amount">5.99</span><span class="pricing-period">/mo</span></div>
                </div>
                <ul class="pricing-features">
                    <li>Everything in Basic, plus:</li>
                    <li>💰 Recipe Monetization</li>
                    <li>⭐ Featured recipe boosts</li>
                    <li>📊 Creator analytics dashboard</li>
                    <li>🎯 Priority support</li>
                </ul>
                <button type="button" class="pricing-select-btn pricing-select-btn--featured" data-tier="plus">Select Plus</button>
            </div>

            <div class="pricing-card" data-tier="premium">
                <div class="pricing-card-header">
                    <h3>Premium</h3>
                    <div class="pricing-price"><span class="pricing-currency">$</span><span class="pricing-amount">10.99</span><span class="pricing-period">/mo</span></div>
                </div>
                <ul class="pricing-features">
                    <li>Everything in Plus, plus:</li>
                    <li>🏆 Golden Premium Badge</li>
                    <li>🚀 Unlimited recipe boosts</li>
                    <li>🎨 Custom profile themes</li>
                    <li>📞 Dedicated support line</li>
                    <li>📈 Advanced analytics &amp; insights</li>
                </ul>
                <button type="button" class="pricing-select-btn" data-tier="premium">Select Premium</button>
            </div>
        </div>

        <div class="subscription-payment" id="payment-section">
            <div class="subscription-payment-inner">
                <h3>Payment Details</h3>
                <div class="selected-tier-display" id="selected-tier-display">
                    Selected: <strong id="selected-tier-name">Basic</strong> — <span id="selected-tier-price">$2.99/mo</span>
                </div>
                <form method="POST" action="{{ path('subscriptions_index') }}" id="subscription-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('subscribe') }}">
                    <input type="hidden" name="tier" id="tier-input" value="basic">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="plan_type">Billing Cycle</label>
                            <select id="plan_type" name="plan_type">
                                <option value="monthly" {{ planType == 'monthly' ? 'selected' : '' }}>Monthly</option>
                                <option value="annual" {{ planType == 'annual' ? 'selected' : '' }}>Annual (save 10%)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="payment_method">Payment Method</label>
                            <select id="payment_method" name="payment_method">
                                <option value="Mock Card">Mock Card</option>
                                <option value="Mock GCash">Mock GCash</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="card_name">Cardholder Name</label>
                        <input type="text" id="card_name" name="card_name" value="{{ user.username }}" required>
                    </div>
                    <div class="form-group">
                        <label for="card_number">Card Number</label>
                        <input type="text" id="card_number" name="card_number" value="4242 4242 4242 4242" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="card_expiry">Expiry (MM/YY)</label>
                            <input type="text" id="card_expiry" name="card_expiry" value="12/28" required>
                        </div>
                        <div class="form-group">
                            <label for="card_cvv">CVV</label>
                            <input type="password" id="card_cvv" name="card_cvv" value="789" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="billing_zip">Billing Zip</label>
                        <input type="text" id="billing_zip" name="billing_zip" value="90210" required>
                    </div>
                    <button type="submit" class="subscribe-btn">Authorize &amp; Subscribe</button>
                </form>
            </div>
        </div>
    </main>

    <script>
    (function() {
        var tierPrices = { basic: '$2.99/mo', plus: '$5.99/mo', premium: '$10.99/mo' };
        var tierNames = { basic: 'Basic', plus: 'Plus', premium: 'Premium' };
        var tierInput = document.getElementById('tier-input');
        var nameEl = document.getElementById('selected-tier-name');
        var priceEl = document.getElementById('selected-tier-price');
        document.querySelectorAll('.pricing-select-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var tier = btn.getAttribute('data-tier');
                tierInput.value = tier;
                nameEl.textContent = tierNames[tier];
                priceEl.textContent = tierPrices[tier];
                document.querySelectorAll('.pricing-card').forEach(function(c) { c.classList.remove('pricing-card--selected'); });
                btn.closest('.pricing-card').classList.add('pricing-card--selected');
                document.getElementById('payment-section').scrollIntoView({ behavior: 'smooth' });
            });
        });
    })();
    </script>
{% endblock %}