{% extends 'layout.html.twig' %}

{% block title %}{{ recipe ? recipe.title : 'Recipe not available' }} - ForkLore{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/recipes.css') }}">
{% endblock %}

{% block content %}
    {% if recipe %}
    <main class="recipe-detail">
        <div class="recipe-detail-image">
            {% set img = recipe.imageFilename|default('default.svg') %}
            <img src="{{ asset('uploads/recipes/' ~ (img in ['default.jpg', 'default'] ? 'default.svg' : img)) }}" alt="{{ recipe.title }}">
        </div>

        <div class="recipe-detail-content">
            <div class="recipe-detail-tags">
                <span class="recipe-category">{{ recipe.category }}</span>
                {% if recipe.cuisine %}
                    <a href="{{ path('recipes_index', { cuisine: recipe.cuisine.slug }) }}" class="badge recipe-cuisine-link">
                        {{ recipe.cuisine.name }} Cuisine
                    </a>
                {% endif %}
            </div>

            <h1>{{ recipe.title }}</h1>

            <p class="recipe-author recipe-author--detail">
                <span>by {% if recipe.user %}<a href="{{ path('profile_show', { username: recipe.user.username }) }}"><strong>{{ recipe.user.username }}</strong></a>{% else %}<strong>Unknown</strong>{% endif %}</span>
                {% if recipe.isPublic is defined and not recipe.isPublic %}<span class="recipe-private-badge">Private</span>{% endif %}
            </p>

            {% if canManage is defined and canManage %}
                <div class="recipe-owner-actions">
                    <a href="{{ path('recipes_edit', { id: recipe.id }) }}" class="recipe-edit-btn">✏️ Edit Recipe</a>
                    <form method="post" action="{{ path('recipes_delete', { id: recipe.id }) }}" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_recipe_' ~ recipe.id) }}">
                        <button type="submit" class="recipe-delete-btn">🗑️ Delete Recipe</button>
                    </form>
                </div>
            {% endif %}

            <div class="recipe-favorite">
                {% if app.user %}
                    <form method="post" action="{{ path('recipes_favorite', { id: recipe.id }) }}" class="recipe-favorite-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('favorite_recipe_' ~ recipe.id) }}">
                        <button type="submit" class="favorite-btn {{ isFavorited ? 'favorited' : '' }}">
                            {{ isFavorited ? '♥' : '♡' }} {{ recipe.totalLikes }} {{ recipe.totalLikes == 1 ? 'Favorite' : 'Favorites' }}
                        </button>
                    </form>
                {% else %}
                    <a href="{{ path('login') }}" class="favorite-btn" title="Log in to save favorites">
                        ♡ {{ recipe.totalLikes }} {{ recipe.totalLikes == 1 ? 'Favorite' : 'Favorites' }}
                    </a>
                {% endif %}
            </div>

            <section>
                <h2>Ingredients</h2>
                {% if recipe.ingredients %}
                    <p>{{ recipe.ingredients|nl2br }}</p>
                {% else %}
                    <p>No ingredients available.</p>
                {% endif %}
            </section>

            <section>
                <h2>Instructions</h2>
                {% if recipe.instructions %}
                    <p>{{ recipe.instructions|nl2br }}</p>
                {% else %}
                    <p>No instructions available.</p>
                {% endif %}
            </section>
        </div>
    </main>
    {% else %}
    <main class="recipe-detail">
        <div class="recipe-empty">
            <h3>Recipe not available yet.</h3>
            <p>Recipe details will appear here once the database is connected.</p>
            <a href="{{ path('recipes_index') }}" class="primary-btn">Back to Recipes</a>
        </div>
    </main>
    {% endif %}
{% endblock %}
