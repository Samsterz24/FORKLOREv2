{% extends 'layout.html.twig' %}

{% block title %}{{ recipe ? 'Edit ' ~ recipe.title : 'Edit Recipe' }} - ForkLore{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/share.css') }}">
{% endblock %}

{% block content %}
    {% if recipe %}
    <main class="share-page edit-recipe-page">
        <div class="edit-recipe-header">
            <div>
                <div class="edit-recipe-breadcrumb">
                    <a href="{{ path('recipes_index') }}">Recipes</a> &rsaquo;
                    <a href="{{ path('recipes_show', { id: recipe.id }) }}">{{ recipe.title }}</a> &rsaquo;
                    Edit
                </div>
                <h1>Edit Recipe</h1>
            </div>

            <div class="edit-recipe-header-actions">
                <a href="{{ path('recipes_show', { id: recipe.id }) }}" class="edit-recipe-cancel">&larr; Cancel &amp; View</a>
                <button type="button" class="edit-recipe-delete" disabled title="Deletion is disabled in this UI preview">🗑️ Delete Recipe</button>
            </div>
        </div>

        <form class="share-form edit-recipe-form" method="post" action="{{ path('recipes_edit', { id: recipe.id }) }}">
            <div class="share-form-panel">
                <div class="mb-3">
                    <label for="title" class="form-label">Recipe Title:</label>
                    <input type="text" id="title" name="title" class="form-control" value="{{ recipe.title }}" required>
                </div>

                <div class="edit-recipe-row">
                    <div>
                        <label for="cuisine_id" class="form-label">Cuisine / Origin:</label>
                        <select id="cuisine_id" name="cuisine_id" class="form-select">
                            <option value="">-- Select Cuisine (Optional) --</option>
                            {% for cuisine in cuisines %}
                                <option value="{{ cuisine.id }}" {{ recipe.cuisineSlug == cuisine.slug ? 'selected' : '' }}>
                                    {{ cuisine.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div>
                        <label for="category" class="form-label">Category:</label>
                        <select id="category" name="category" class="form-select" required>
                            {% for category in categories %}
                                <option value="{{ category }}" {{ recipe.category == category ? 'selected' : '' }}>{{ category }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="recipe_image" class="form-label">Recipe Image:</label>
                    <div class="edit-recipe-image-row">
                        <img src="{{ asset(recipe.image) }}" alt="Current Recipe Image" class="edit-recipe-current-image">
                        <div class="edit-recipe-image-field">
                            <input type="file" id="recipe_image" name="recipe_image" class="form-control" accept="image/*">
                            <span class="form-hint">Leave blank to keep your current photo. Supports JPG, PNG, WEBP.</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="ingredients" class="form-label">Ingredients (one per line):</label>
                    <textarea id="ingredients" name="ingredients" class="form-control" rows="6" required>{{ recipe.ingredients|join("\n") }}</textarea>
                </div>

                <div class="mb-3">
                    <label for="instructions" class="form-label">Instructions / Steps:</label>
                    <textarea id="instructions" name="instructions" class="form-control" rows="8" required>{{ recipe.instructions }}</textarea>
                </div>

                <div class="mb-3 monetization-box">
                    <label class="monetization-label">💰 Recipe Monetization</label>
                    <p class="monetization-note">
                        Lock your recipes behind the paywall to earn creator revenue with a
                        <span class="monetization-link">Lore Foodie Stamp ($2.99/mo)</span>.
                    </p>
                </div>

                <div class="edit-recipe-submit-row">
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                    <a href="{{ path('recipes_show', { id: recipe.id }) }}" class="edit-recipe-discard">Discard</a>
                </div>
            </div>

            <div class="share-form-panel share-form-panel--details">
                <div class="edit-recipe-side-card">
                    <h4>Editing Tips</h4>
                    <ul>
                        <li>Corrections are saved immediately and updated across search and catalogs.</li>
                        <li>Ensure each ingredient is on its own separate line for clean checklist formatting.</li>
                        <li>If you replace your photo, the old image is securely cleaned up.</li>
                    </ul>
                </div>

                <div class="edit-recipe-danger-card">
                    <h4>Danger Zone</h4>
                    <p>Deleting this recipe will permanently remove its instructions, ingredients, image, and all user favorites. This action cannot be undone.</p>
                    <button type="button" disabled title="Deletion is disabled in this UI preview">Delete This Recipe</button>
                </div>
            </div>
        </form>
    </main>
    {% else %}
    <main class="share-page edit-recipe-page">
        <div class="edit-recipe-header">
            <div>
                <div class="edit-recipe-breadcrumb">
                    <a href="{{ path('recipes_index') }}">Recipes</a> &rsaquo; Edit
                </div>
                <h1>Edit Recipe</h1>
            </div>
        </div>
        <div class="share-form-panel">
            <p class="form-hint">Recipe editing will be available once the database is connected.</p>
        </div>
    </main>
    {% endif %}
{% endblock %}
