{% extends 'layout.html.twig' %}

{% block title %}{{ recipe ? 'Edit ' ~ recipe.title : 'Edit Recipe' }} - ForkLore{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/share.css') }}">
{% endblock %}

{% block content %}
    {% if recipe %}
    <main class="share-page edit-recipe-page">
        <div class="edit-recipe-header">
            <div>
                <div class="edit-recipe-breadcrumb">
                    <a href="{{ path('recipes_index') }}">Recipes</a> &rsaquo;
                    <a href="{{ path('recipes_show', { id: recipe.id }) }}">{{ recipe.title }}</a> &rsaquo;
                    Edit
                </div>
                <h1>Edit Recipe</h1>
            </div>

            <div class="edit-recipe-header-actions">
                <a href="{{ path('recipes_show', { id: recipe.id }) }}" class="edit-recipe-cancel">&larr; Cancel &amp; View</a>
            </div>
        </div>

        {{ form_start(form, {'attr': {'class': 'share-form edit-recipe-form', 'enctype': 'multipart/form-data'}}) }}
            <div class="share-form-panel">
                <div class="mb-3">
                    {{ form_label(form.title, 'Recipe Title:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.cuisine, 'Cuisine / Origin:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.cuisine, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.cuisine) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.category, 'Category:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.category) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.recipe_image, 'Recipe Image:', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="edit-recipe-image-row">
                        {% set img = recipe.imageFilename|default('default.svg') %}
                        <img src="{{ asset('uploads/recipes/' ~ (img in ['default.jpg', 'default'] ? 'default.svg' : img)) }}" alt="Current Recipe Image" class="edit-recipe-current-image">
                        <div class="edit-recipe-image-field">
                            {{ form_widget(form.recipe_image, {'attr': {'class': 'form-control', 'accept': 'image/jpeg,image/png,image/webp'}}) }}
                            {{ form_errors(form.recipe_image) }}
                            <span class="form-hint">Leave blank to keep your current photo. Supports JPG, PNG, WebP.</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.ingredients, 'Ingredients (one per line):', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.ingredients, {'attr': {'class': 'form-control', 'rows': 6}}) }}
                    {{ form_errors(form.ingredients) }}
                </div>

                <div class="edit-recipe-submit-row">
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                    <a href="{{ path('recipes_show', { id: recipe.id }) }}" class="edit-recipe-discard">Discard</a>
                </div>
            </div>

            <div class="share-form-panel share-form-panel--details">
                <div class="edit-recipe-side-card">
                    <h4>Editing Tips</h4>
                    <ul>
                        <li>Changes are saved to the database when you submit this form.</li>
                        <li>Leave the image field blank to keep your current photo.</li>
                        <li>If you replace your photo, the old uploaded image is cleaned up when it is safe to do so.</li>
                    </ul>
                </div>

                <div class="edit-recipe-danger-card">
                    <h4>Danger Zone</h4>
                    <p>Deleting this recipe will permanently remove its details and associated favorites. This action cannot be undone.</p>
                </div>
            </div>
        {{ form_end(form) }}

        <form method="post" action="{{ path('recipes_delete', { id: recipe.id }) }}" onsubmit="return confirm('Are you sure you want to delete this recipe? This action cannot be undone.');" style="margin-top: 16px;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_recipe_' ~ recipe.id) }}">
            <button type="submit" class="edit-recipe-delete">🗑️ Delete Recipe</button>
        </form>
    </main>
    {% else %}
    <main class="share-page edit-recipe-page">
        <div class="edit-recipe-header">
            <div>
                <div class="edit-recipe-breadcrumb">
                    <a href="{{ path('recipes_index') }}">Recipes</a> &rsaquo; Edit
                </div>
                <h1>Edit Recipe</h1>
            </div>
        </div>
        <div class="share-form-panel">
            <p class="form-hint">Recipe not found.</p>
        </div>
    </main>
    {% endif %}
{% endblock %}
