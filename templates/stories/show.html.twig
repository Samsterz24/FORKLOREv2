{% extends 'layout.html.twig' %}

{% block title %}{{ story ? story.title : 'Story not available' }} - ForkLore Stories{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/stories.css') }}">
{% endblock %}

{% block content %}
    {% if story %}
    <main class="story-detail-page">
        <a href="{{ path('stories_index') }}" class="story-detail-back">&larr; Back to all stories</a>

        <header class="story-detail-header">
            <div class="story-badge-row">
                <span class="story-location-tag">{{ story.location }}</span>
                {% if story.cuisine %}
                    <a href="{{ path('recipes_index', { cuisine: story.cuisine.slug }) }}" class="badge story-cuisine-badge">
                        {{ story.cuisine.name }} Cuisine
                    </a>
                {% endif %}
            </div>

            <h1>{{ story.title }}</h1>

            <div class="story-meta-row">
                <span>By {% if story.user %}<a href="{{ path('profile_show', { username: story.user.username }) }}"><b>{{ story.authorName }}</b></a>{% else %}<b>{{ story.authorName }}</b>{% endif %}</span>
                <span>&bull;</span>
                <span>{{ story.createdAt|date('F j, Y') }}</span>
                <span>&bull;</span>
                <span>♥ {{ story.savesCount }} saves</span>
            </div>
            <div class="story-actions-row" style="margin-top:12px;">
                {% if app.user %}
                    <form method="post" action="{{ path('stories_save', { id: story.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('save_story_' ~ story.id) }}">
                        <button type="submit" class="primary-btn">{{ isSaved ? '♥ Saved' : '♡ Save Story' }}</button>
                    </form>
                {% else %}
                    <a href="{{ path('login') }}" class="primary-btn">♡ Save Story</a>
                {% endif %}
            </div>
        </header>

        <div class="story-detail-banner">
            {% set img = story.imageFilename|default('default.svg') %}
            <img src="{{ asset('uploads/stories/' ~ (img in ['default.jpg','default'] ? 'default.svg' : img)) }}" alt="{{ story.title }}">
        </div>

        {% if story.quote %}
            <blockquote class="story-pull-quote">
                "{{ story.quote }}"
            </blockquote>
        {% endif %}

        <article class="story-narrative">
            {{ narrative|nl2br }}
        </article>

        {% if highlights is not empty %}
            <div class="story-highlights-box">
                <h3>Traditions &amp; Story Highlights</h3>
                <ul>
                    {% for highlight in highlights %}
                        <li>{{ highlight }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if story.recipe %}
            <div class="story-related-recipe">
                <div>
                    <span class="story-related-label">Related Community Recipe</span>
                    <h4>{{ story.recipe.title }}</h4>
                </div>
                <a href="{{ path('recipes_show', { id: story.recipe.id }) }}" class="primary-btn">View Recipe &rarr;</a>
            </div>
        {% endif %}
    </main>
    {% else %}
    <main class="story-detail-page">
        <a href="{{ path('stories_index') }}" class="story-detail-back">&larr; Back to all stories</a>
        <div class="stories-empty">
            <h3>No story available yet.</h3>
            <p>Story details will appear here once the database is connected.</p>
            <div class="stories-empty-action">
                <a href="{{ path('share_story') }}" class="primary-btn">+ Share Your Story</a>
            </div>
        </div>
    </main>
    {% endif %}
{% endblock %}
