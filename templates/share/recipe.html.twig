{% extends 'layout.html.twig' %}

{% block title %}Share a New Recipe - ForkLore{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/share.css') }}">
{% endblock %}

{% block content %}
    <main class="share-page">
        <div class="share-intro">
            <span class="share-eyebrow">ADD TO THE COMMUNITY COOKBOOK</span>
            <h2>Share a New Recipe</h2>
            <p>Write down the dish your family asks for by name. Your draft is saved in this session so you won't lose it if you refresh.</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'share-form', 'enctype': 'multipart/form-data'}}) }}
            <div class="share-form-panel">
                <div class="mb-3">
                    {{ form_label(form.title, 'Recipe Title:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': "e.g. Your family's signature dish"}}) }}
                    {{ form_errors(form.title) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.cuisine, 'Cuisine / Origin:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.cuisine, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.cuisine) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.category, 'Category:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.category) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.recipe_image, 'Recipe Image:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.recipe_image, {'attr': {'class': 'form-control', 'accept': 'image/jpeg,image/png,image/webp'}}) }}
                    {{ form_errors(form.recipe_image) }}
                    <small class="form-hint">Upload a JPG, PNG, or WebP image (max 5MB). If you refresh, you may need to reselect the image.</small>
                </div>

                <div class="mb-3">
                    {{ form_label(form.ingredients, 'Ingredients (one per line):', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.ingredients, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': "2 cups Flour\n1 tsp Salt\n1 cup Milk"}}) }}
                    {{ form_errors(form.ingredients) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.instructions, 'Instructions / Steps:', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.instructions, {'attr': {'class': 'form-control', 'rows': 8, 'placeholder': "1. Prepare ingredients...\n2. Cook and combine...\n3. Serve and enjoy."}}) }}
                    {{ form_errors(form.instructions) }}
                    <small class="form-hint">Write clear step-by-step instructions for preparing the recipe.</small>
                </div>

                <div class="mb-3 monetization-box">
                    <label class="monetization-label">💰 Recipe Monetization</label>
                    {% if hasFoodieStamp %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="is_monetized" value="1" id="is_monetized">
                            <label class="form-check-label" for="is_monetized">
                                <strong>Exclusive Recipe:</strong> Lock this recipe for Lore Foodie Stamp subscribers to earn monetization revenue.
                            </label>
                        </div>
                    {% else %}
                        <p class="monetization-note">
                            Lock your recipes behind the paywall to earn creator revenue with a
                            <span class="monetization-link">Lore Foodie Stamp ($2.99/mo)</span>.
                        </p>
                    {% endif %}
                </div>

                <button type="submit" class="btn btn-primary">Publish Recipe</button>
            </div>

            <div class="share-form-panel share-form-panel--details">
                <div class="share-note">
                    <strong>Recipe Tips</strong>
                    <ul>
                        <li>Keep measurements clear and specific.</li>
                        <li>Add notes about preparation or the story behind the dish.</li>
                        <li>Your draft is kept in this session if you accidentally refresh.</li>
                    </ul>
                </div>
            </div>
        {{ form_end(form) }}
    </main>
{% endblock %}
